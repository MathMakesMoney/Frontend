#!/bin/sh
# main 으로 바로 푸시할 때만 검증한다. 다른 브랜치는 PR CI 가 본다
# 켜기: git config core.hooksPath .githooks / 건너뛰기: git push --no-verify
while read local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  echo "main 푸시: 타입 검사, vitest, Playwright 실행 (약 15초)"
  npx tsc --noEmit && npx vitest run && npm run -s test:e2e || { echo "검증 실패: main 푸시를 막았습니다"; exit 1; }
done
exit 0
